---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import Navbar from '../components/Navbar.jsx';
import Hero from '../components/Hero.jsx';
import ServiciosHero from '../components/ServiciosHero.jsx';
import ServiciosContenido from '../components/ServiciosContenido.jsx';
import Formatos from '../components/Formatos.jsx';
import Casos from '../components/Casos.jsx';
import WhatIsCoaching from '../components/WhatIsCoaching.jsx';
import About from '../components/About.jsx';
import Contact from '../components/Contact.jsx';
import Footer from '../components/Footer.jsx';
import WhatsAppFloat from '../components/WhatsAppFloat.jsx';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Coaching de Raíz",
  "url": "https://www.coachingderaiz.com",
  "description": "Coaching ontológico empresarial en Buenos Aires: coaching ejecutivo, coaching de equipos y transformación organizacional a medida, por Lucía Vallejo."
};
---

<BaseLayout
  title="Coaching de Raíz | Lucía Vallejo - Coach Ontológica Empresarial Buenos Aires"
  description="Coaching ontológico empresarial en Buenos Aires: coaching ejecutivo, coaching de equipos y transformación organizacional a medida, por Lucía Vallejo."
  canonical="/"
  keywords="coaching ontológico empresarial Buenos Aires, coaching ejecutivo, coaching de equipos, transformación organizacional, Lucía Vallejo"
  schema={schema}
>
  <Navbar client:load />
  <main>
    <Hero client:load />
    <About client:visible />
    <section id="servicios">
      <ServiciosHero client:load />
      <ServiciosContenido client:visible />
    </section>
    <Formatos client:visible />
    <Casos client:visible />
    <WhatIsCoaching client:visible />
    <Contact client:visible />
  </main>
  <Footer client:load />
  <WhatsAppFloat client:load />
</BaseLayout>