---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
import Navbar from '../../components/Navbar.jsx';
import Footer from '../../components/Footer.jsx';
import WhatsAppFloat from '../../components/WhatsAppFloat.jsx';
import { sanityClient } from '../../lib/sanity';
import { ALL_POSTS_QUERY } from '../../lib/queries';
import BlogCard from '../../components/BlogCard.jsx';
import { WHATSAPP_URL } from '../../lib/site';

let posts = [];
let error = null;

try {
  posts = await sanityClient.fetch(ALL_POSTS_QUERY);
} catch (e) {
  error = e.message;
  console.error('Error fetching posts:', e);
}

const schema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Blog de Coaching de Raíz",
  "url": "https://www.coachingderaiz.com/blog/",
  "description": "Artículos de Lucía Vallejo sobre coaching ontológico empresarial, coaching ejecutivo, coaching de equipos y transformación organizacional.",
  "author": {
    "@type": "Person",
    "name": "Lucía Vallejo"
  }
};
---

<BaseLayout
  title="Blog | Coaching ejecutivo, equipos y transformación organizacional - Lucía Vallejo"
  description="Artículos de Lucía Vallejo sobre coaching ontológico empresarial, coaching ejecutivo, coaching de equipos y transformación organizacional."
  canonical="/blog/"
  keywords="blog coaching ontológico empresarial, coaching ejecutivo, coaching de equipos, transformación organizacional, Lucía Vallejo"
  schema={schema}
>
  <Navbar client:load />
  <main class="min-h-screen bg-papel">

    <section class="container-custom pt-36 pb-12 text-center">
      <p class="eyebrow">Blog</p>
      <h1 class="mt-4 font-heading">Coaching & Liderazgo</h1>
      <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-tinta-soft md:text-lg">
        Reflexiones y herramientas para líderes, equipos y organizaciones
      </p>
    </section>

    <section class="container-custom pb-20">

      {error && (
        <div class="py-20 text-center">
          <p class="text-lg text-tinta-soft">Error al cargar los artículos. Intentá más tarde.</p>
        </div>
      )}

      {!error && posts.length === 0 && (
        <div class="py-20 text-center">
          <h2 class="font-heading text-2xl font-medium text-tinta">Próximamente</h2>
          <p class="mx-auto mt-3 max-w-md text-tinta-soft">
            Lucía está preparando artículos sobre coaching ontológico, liderazgo y transformación de equipos.
          </p>
          <a href="/" class="btn-primary mt-6">
            Volver al inicio
          </a>
        </div>
      )}

      {!error && posts.length > 0 && (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map(post => (
            <BlogCard post={post} client:load />
          ))}
        </div>
      )}

    </section>

    <section class="section-padding bg-gradient-radial from-naranja via-terracota to-terracota-dark text-center text-white">
      <div class="container-custom">
        <div class="mx-auto max-w-3xl">
          <h2 class="font-heading text-white">¿Querés transformar tu liderazgo?</h2>
          <p class="mx-auto mt-5 max-w-md text-base leading-relaxed text-white/90">
            Contanos tu desafío y conversemos sobre tus objetivos.
          </p>
          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-crema mt-8"
          >
            Agendar una charla
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer client:load />
  <WhatsAppFloat client:load />
</BaseLayout>
