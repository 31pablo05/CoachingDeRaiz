---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
import Navbar from '../../components/Navbar.jsx';
import Footer from '../../components/Footer.jsx';
import WhatsAppFloat from '../../components/WhatsAppFloat.jsx';
import { sanityClient, urlFor } from '../../lib/sanity';
import { ALL_SLUGS_QUERY, POST_BY_SLUG_QUERY } from '../../lib/queries';
import { PortableText } from '@portabletext/react';
import { WHATSAPP_URL } from '../../lib/site';

export async function getStaticPaths() {
  try {
    const slugs = await sanityClient.fetch(ALL_SLUGS_QUERY);
    return slugs.map(({ slug }) => ({ params: { slug } }));
  } catch {
    // Sanity not configured yet — no static paths to generate
    return [];
  }
}

const { slug } = Astro.params;
const post = await sanityClient.fetch(POST_BY_SLUG_QUERY, { slug });

if (!post) {
  return Astro.redirect('/blog/');
}

const imageUrl = post.mainImage
  ? urlFor(post.mainImage).width(1200).height(630).url()
  : '/imagenes/og-image.jpg';

const date = new Date(post.publishedAt).toLocaleDateString('es-AR', {
  year: 'numeric', month: 'long', day: 'numeric'
});

const categoryLabels = {
  'liderazgo': 'Liderazgo',
  'equipos': 'Equipos',
  'coaching-ontologico': 'Coaching Ontológico',
  'organizaciones': 'Organizaciones',
  'desarrollo-personal': 'Desarrollo Personal',
};

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.seoTitle || post.title,
  "description": post.seoDescription || post.excerpt,
  "image": imageUrl,
  "author": {
    "@type": "Person",
    "name": "Lucía Vallejo",
    "url": "https://www.coachingderaiz.com/sobre-mi/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Coaching de Raíz",
    "url": "https://www.coachingderaiz.com"
  },
  "datePublished": post.publishedAt,
  "url": `https://www.coachingderaiz.com/blog/${slug}/`
};
---

<BaseLayout
  title={`${post.seoTitle || post.title} | Blog Coaching de Raíz`}
  description={post.seoDescription || post.excerpt}
  canonical={`/blog/${slug}/`}
  ogImage={imageUrl}
  ogType="article"
  schema={schema}
>
  <Navbar client:load />
  <main class="min-h-screen bg-papel">

    <article class="container-custom max-w-4xl pt-40 pb-16">

      <div class="rounded-[28px] border border-crema-dark bg-white p-6 shadow-soft sm:p-8 md:p-12 lg:border-0 lg:bg-transparent lg:p-0 lg:shadow-none">

        <div class="mb-10 flex flex-col gap-8 border-b border-crema-dark pb-10 md:flex-row">

          {post.mainImage && (
            <div class="w-full shrink-0 md:w-64 lg:w-72">
              <div class="aspect-[3/4] overflow-hidden rounded-[28px] shadow-soft">
                <img
                  src={urlFor(post.mainImage).width(400).height(530).url()}
                  alt={post.mainImage?.alt || post.title}
                  class="h-full w-full object-cover object-top"
                />
              </div>
            </div>
          )}

          <div class="flex flex-col justify-center gap-4">

            <div class="flex flex-wrap items-center gap-2">
              <span class="chip">
                {categoryLabels[post.category] || post.category}
              </span>
              <span class="text-xs text-tinta-soft">{date}</span>
              <span class="text-xs text-tinta-soft">·</span>
              <span class="text-xs text-tinta-soft">{post.readTime} min de lectura</span>
            </div>

            <h1 class="font-heading text-3xl font-semibold leading-tight text-tinta lg:text-4xl">
              {post.title}
            </h1>

            <p class="border-l-4 border-terracota pl-4 text-base leading-relaxed text-tinta-soft">
              {post.excerpt}
            </p>

            <div class="mt-2 flex items-center gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-crema text-sm font-semibold text-bosque-dark">
                LV
              </div>
              <div>
                <p class="text-sm font-semibold text-tinta">Lucía Vallejo</p>
                <p class="text-xs text-tinta-soft">Coach Ontológica Empresarial</p>
              </div>
            </div>

          </div>
        </div>

        <div class="prose prose-lg max-w-none font-body
          prose-headings:font-heading prose-headings:font-medium prose-headings:text-tinta
          prose-h2:text-2xl prose-h2:mt-8 prose-h2:mb-4
          prose-h3:text-xl prose-h3:mt-6 prose-h3:mb-3
          prose-p:text-tinta-soft prose-p:leading-relaxed prose-p:mb-4
          prose-strong:text-tinta
          prose-blockquote:border-l-4 prose-blockquote:border-terracota
          prose-blockquote:bg-crema prose-blockquote:py-2 prose-blockquote:px-4 prose-blockquote:rounded-r-lg
          prose-blockquote:text-tinta prose-blockquote:not-italic
          prose-img:rounded-[28px] prose-img:shadow-soft
          prose-a:text-terracota prose-a:underline">
          {post.body && <PortableText value={post.body} client:load />}
        </div>

      </div>

      <div class="mt-8">
        <a
          href="/blog/"
          class="text-sm font-semibold text-terracota underline-offset-4 hover:underline"
        >
          ← Volver al blog
        </a>
      </div>

    </article>

    <section aria-labelledby="blog-cierre-titulo" class="section-padding bg-gradient-radial from-naranja via-terracota to-terracota-dark text-center text-white">
      <div class="container-custom">
        <div class="mx-auto max-w-3xl">
          <h2 id="blog-cierre-titulo" class="font-heading text-white">¿Qué necesita mover tu organización?</h2>
          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-crema mt-8"
          >
            Contanos tu desafío
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer client:load />
  <WhatsAppFloat client:load />
</BaseLayout>
